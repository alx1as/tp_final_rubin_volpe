# Copiar a backend/.env y configurar la base local antes de iniciar.
# Agregar usuario y contraseña locales si PostgreSQL los requiere.
# Codificar caracteres reservados de la contraseña en la URL (por ejemplo, @ como %40).
DATABASE_URL=postgresql+psycopg://localhost:5432/seguimiento
# Lista JSON de orígenes permitidos, sin barra final ni comodines.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# En producción con HTTPS, establecer true.
SESSION_COOKIE_SECURE=false
